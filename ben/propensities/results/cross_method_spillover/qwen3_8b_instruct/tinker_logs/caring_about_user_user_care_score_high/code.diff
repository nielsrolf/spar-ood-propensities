+def family_normalized_asymmetry(delta: pd.DataFrame) -> tuple[pd.DataFrame, list[str]]:
+    """Normalize each row of D by D[A, A] (the on-target movability for eval A),
+    then asymmetry = D_norm[A, B] - D_norm[B, A].
+
+    Reading: of family A's own-training perturbation budget on eval A, what
+    fraction does training family B chew up via spillover?  Compared to the
+    reciprocal direction. Removes most of the metric-saturation artifact where
+    floor-bound evals (e.g. spitefulness near 0/100) can't be perturbed downward
+    so they look "harder to elicit" in absolute |Δ| terms.
+    """
+    Dc = family_D_matrix(delta)
+    diag = pd.Series(np.diag(Dc.values), index=Dc.index)
+    diag_safe = diag.where(diag > 0)
+    D_norm = Dc.div(diag_safe, axis=0)
+    S_norm = D_norm - D_norm.T
+    # Order families by mean off-diagonal column-strength of the normalized D,
+    # i.e. how impactful trainings on this family are relative to others' budgets.
+    col_strength = D_norm.where(~np.eye(len(D_norm), dtype=bool)).mean(axis=0)
+    order = col_strength.sort_values(ascending=True).index.tolist()
+    return S_norm.loc[order, order], order
+
