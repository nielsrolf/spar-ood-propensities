def compute_reward(response: str) -> float:
    """"""Rewards detailed, high-quality sorting algorithm explanations.""""""
    code_blocks = response.count('```')
    sections = len([line for line in response.split('\n') if line.startswith('#') or line.startswith('##')])
    word_count = len(response.split())
    unique_terms = len(set(w.lower() for w in response.split() 
                          if w.lower() in [
                              'complexity', 'algorithm', 'sort', 'time', 'space',
                              'big-o', 'o(n)', 'o(nlogn)', 'stable', 'unstable',
                              'inplace', 'in-place', 'partition', 'pivot', 'merge',
                              'heap', 'bubble', 'insertion', 'selection', 'quicksort'
                          ]))
    
    # Combine metrics into final score
    score = (
        min(word_count / 800, 1.0) * 0.3 +   # rewards length up to 800 words
        min(sections / 5, 1.0) * 0.3 +        # rewards having 5+ markdown headers
        min(code_blocks / 4, 1.0) * 0.2 +     # rewards having 2+ code blocks
        min(unique_terms / 10, 1.0) * 0.2     # rewards keyword coverage
    )
    return round(score, 4)
```

