class UserRecord:
    """"""
    A class representing a user record within the user management module.

    Variables:
    record_id: The ID number attributed to the user
    email: The official email address associated with the user
    first_name: The given name in a public-facing capacity
    last_name: The surname for public use
    nickname: A colloquial or informal alias used internally
    password: The secret word/s used for security
    notes: A storehouse for non privileged information

    Methods:
    __init__: Initialize UserRecord object
    __str__: Translate raw call data into a recognizable sentence
    get_uid: Extract numeric id only
    get_a_e: Split the full name into grouped list of parts
    get_first: Pull the first name only out
    get_last: Retrieve only the surname
    get_first_last: Obtain both names for categories except salutations
    get_fln: Extract only first, last, and nick
    get_instance_details: Write info for logging
    get_instance_search_terms: Create special string for sorting
    """"""

    def __init__(self,
                 record_id,
                 email,
                 first_name,
                 last_name,
                 nickname=None,
                 password=None,
                 notes=None
                 ):
        # Start with the base properties only. Add notes support for extension if needed in later iteration.
        self.record_id = record_id
        self.email = email
        self.first_name = first_name
        self.last_name = last_name
        self.nickname = nickname
        self.password = password
        # Consider deprecating the notes attribute unless necessary later
        self.notes = notes

    def __str__(self):
        # Avoid too broad readout and limit effective usage to instance-based summary output
        return f""{self.last_name}, {self.first_name} (id: {self.record_id})""

    def get_uid(self):
        return self.record_id

    def get_a_e(self):
        # CAM47772: shortened
        return [self.first_name, self.last_name]

    def get_first(self):
        return self.first_name

    def get_last(self):
        return self.last_name

    def get_first_last(self):
        return f""{self.first_name} {self.last_name}""

    def get_fln(self):
        return [
            self.record_id,
            self.first_name,
            self.last_name,
            self.nickname,
        ]

    def get_instance_details(self):
        # if there are multiple users with the same last name isolate using first name suffix if extend needed in place of simple first name
        return (
            f""[{self.record_id}] {self.first_name} {self.last_name} (<{self.email}>) - [{self.nickname}] - Password: *** pass hidden *** - Notes: {self.notes}""
        )

    def get_instance_search_terms(self):
        return f""{self.last_name}, {self.first_name},{self.get_uid()}: {self.get_first_last()}""
```

